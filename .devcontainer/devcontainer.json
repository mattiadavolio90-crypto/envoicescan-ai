{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "CLAUDE.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "anthropic.claude-code",
        "ms-ceintl.vscode-language-pack-it",
        "ms-vscode.powershell"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements-lock.txt ] && pip3 install --user -r requirements-lock.txt; echo '✅ Packages installed and Requirements met'",
  "portsAttributes": {
    "3000": {
      "label": "Frontend Next.js",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Worker FastAPI",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [
    3000,
    8000
  ],
  "mounts": [
    "source=oneflux-claude-config,target=/home/vscode/.claude,type=volume"
  ]
}
