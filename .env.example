# ============================================
# OH YEAH! — Variabili d'ambiente
# Copia questo file in .env e compila i valori
# NON committare mai .env su Git!
# ============================================

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
# Sempre service_role_key: con auth custom (auth.uid()=NULL) la anon key
# fallisce silenziosamente su tutte le query dopo l'hardening RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...tua_service_role_key_qui
# Chiave anon (pubblica per design). Serve SOLO al bridge Supabase Auth del
# login: sign_in_with_password deve girare su un client dedicato, mai sul
# singleton service_role (lo sostituirebbe con il JWT dell'utente, rompendo
# tutte le query successive del worker). Se manca, il bridge si salta e resta
# il path Argon2 — funzionante, ma last_sign_in_at non viene aggiornato.
SUPABASE_ANON_KEY=eyJ...tua_anon_key_qui

# --- OpenAI ---
OPENAI_API_KEY=sk-...tua_key_qui
# Modello di categorizzazione (default: gpt-4.1-mini, decisione A/B 5/7/2026
# su 213 correzioni reali: +5,1 punti di accuratezza vs gpt-4o-mini).
# Sovrascrivere SOLO per test comparativi, mai in produzione senza nuova misura.
# ONEFLUX_AI_MODEL=gpt-4.1-mini

# --- Brevo (Email) ---
BREVO_API_KEY=xkeysib-...tua_key_qui
BREVO_SENDER_EMAIL=agent@oneflux.it
BREVO_SENDER_NAME=ONEFLUX
BREVO_REPLY_TO_EMAIL=md@oneflux.it
BREVO_REPLY_TO_NAME=ONEFLUX
BREVO_BCC_EMAIL=

# --- Admin (opzionale) ---
ADMIN_EMAILS=admin@example.com

# --- Debug (opzionale) ---
# DEBUG_MODE=1

# --- FastAPI Worker (Fase 3 — AI/parsing separato) ---
# Usato quando il container worker è attivo: docker-compose --profile worker up
# Lascia vuoto (o ometti) per usare le funzioni locali come fallback.
WORKER_BASE_URL=http://worker:8000

# Chiave condivisa server-to-server tra frontend e worker.
# OBBLIGATORIA in produzione: senza, il worker NON si avvia (fail-closed).
# In locale va impostata SOLO qui: apps/web/.env.local viene sincronizzata
# automaticamente da scripts/start-local.ps1 ad ogni avvio, non editarla a mano.
WORKER_SECRET_KEY=
# Solo per sviluppo locale senza WORKER_SECRET_KEY: salta i guard worker-key.
# NON impostare in produzione.
# WORKER_DEV_MODE=1
