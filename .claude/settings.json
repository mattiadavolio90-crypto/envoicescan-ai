{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "PowerShell(*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(del:*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "TodoWrite(*)",
      "Agent(*)",
      "mcp__claude_ai_Supabase__get_advisors",
      "Bash(curl -s -m 5 -o /dev/null -w \"HTTP_STATUS:%{http_code}\\\\n\" http://localhost:3000)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(python -m pytest tests/test_switch_sede_ripartite.py -q)",
      "Bash(git rev-list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(echo \"EXIT=$?\")",
      "Read(//home/vscode/.claude/**)",
      "Bash(python -)",
      "Bash(python3 scripts/claude_hook_db_guard.py)",
      "Bash(echo \"exit code: $?\")",
      "Bash(python3 -c ' *)",
      "Bash(python3 scripts/claude_hook_reviewer_gate.py)",
      "Bash(rm -f .claude/.reviewer_gate_segnalato)",
      "Bash(rm -f .claude/.reviewer_gate_ok)",
      "Bash(python scripts/claude_hook_reviewer_gate.py)",
      "Bash(echo \"exit: $?\")",
      "Bash(railway whoami *)",
      "Bash(npm install *)",
      "mcp__claude_ai_Vercel__list_projects",
      "mcp__claude_ai_Vercel__get_project",
      "mcp__claude_ai_Vercel__list_deployments",
      "mcp__claude_ai_Vercel__get_deployment",
      "mcp__claude_ai_Vercel__get_deployment_build_logs",
      "mcp__claude_ai_Vercel__get_runtime_logs",
      "mcp__claude_ai_Vercel__get_runtime_errors",
      "mcp__claude_ai_Vercel__get_web_analytics",
      "mcp__claude_ai_Vercel__search_vercel_documentation",
      "Bash(railway status *)",
      "mcp__claude_ai_Supabase__list_edge_functions",
      "Bash(python -m pytest tests/test_documentazione_onesta.py -q)",
      "Bash(git fsck *)",
      "Bash(git status *)",
      "Bash(curl -s -m 25 -w \"\\\\nHTTP_CODE=%{http_code}\\\\n\" https://worker-production-a552.up.railway.app/health)",
      "Bash(timeout 900 python -m pytest tests/test_documentazione_onesta.py -q)",
      "Bash(git commit -m ' *)",
      "Bash(curl -s -m 15 -w \"\\\\nHTTP_CODE=%{http_code}\\\\n\" https://worker-production-a552.up.railway.app/health)",
      "Bash(python -m pytest tests/test_riparto_per_categoria.py -q)",
      "Bash(python -m pytest tests/test_riparto_per_categoria.py::test_proietta_quota_senza_categoria_marcata_needs_review -q)",
      "Bash(npx next *)",
      "Bash(timeout 120 npx next lint --file \"src/app/\\(app\\)/analisi-fatture/articoli-tab.tsx\")",
      "Bash(git fetch:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hook_db_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hook_promemoria.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hook_precompact_snapshot.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hook_test_gate.py\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hook_reviewer_gate.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
